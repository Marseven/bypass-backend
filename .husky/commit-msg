#!/bin/sh

commit_msg_file="$1"
commit_msg=$(head -1 "$commit_msg_file")

# Conventional commit pattern: type(scope): description
pattern="^(feat|fix|refactor|style|docs|chore|test|perf|ci)(\(.+\))?: .{1,72}$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
    echo ""
    echo "ERROR: Commit message does not follow Conventional Commits format."
    echo ""
    echo "  Expected: type(scope): description"
    echo "  Types: feat, fix, refactor, style, docs, chore, test, perf, ci"
    echo "  Max length: 72 characters"
    echo ""
    echo "  Examples:"
    echo "    feat(auth): add 2FA toggle in security settings"
    echo "    fix(requests): correct dual validation workflow"
    echo "    chore: update dependencies"
    echo ""
    echo "  Your message: $commit_msg"
    echo ""
    exit 1
fi
